# Frontend Environment Configuration (Vercel / Local)
# In local development: Points to local Node.js backend
# In production on Vercel: Set to your deployed Render service URL (e.g., https://entreprise-ai-api.onrender.com)
VITE_API_BASE_URL=http://localhost:10000

# Optional Supabase Public Anon Configuration (Leave blank for in-memory/demo mode)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
