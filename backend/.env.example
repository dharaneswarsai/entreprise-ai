# =========================================================================
# Entreprise AI Backend Environment Configuration (Render / Local)
# =========================================================================

# Server Configuration
NODE_ENV=production
PORT=10000
FRONTEND_URL=https://your-frontend.vercel.app

# Optional Database Configuration (Leave blank for in-memory / demo mode)
# In production with Supabase PostgreSQL:
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider Configuration
# Supported providers: 'openai' | 'anthropic' | 'gemini' | 'ollama' | 'grounded_engine'
AI_PROVIDER=grounded_engine
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1/chat/completions
